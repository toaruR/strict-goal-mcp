{
  "schema_version": "evaluation-v2",
  "issue_record": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "criterion_id", "anchor_clause_ids", "severity", "state", "first_seen", "last_evaluated", "locator", "claim", "evidence_refs", "resolution_condition", "dependency_keys", "duplicate_of", "history"],
    "properties": {
      "id": { "type": "string", "pattern": "^ISS-[A-Za-z0-9._-]{1,120}$" }, "criterion_id": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" }, "anchor_clause_ids": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }, "severity": { "enum": ["blocking", "major", "advisory"] }, "state": { "enum": ["open", "reaffirmed", "resolved", "reopened", "superseded", "needs_triage"] },
      "first_seen": { "type": "object", "additionalProperties": false, "required": ["session_id", "round", "context_digest"], "properties": { "session_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "round": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "context_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
      "last_evaluated": { "type": "object", "additionalProperties": false, "required": ["session_id", "round", "context_digest"], "properties": { "session_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "round": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "context_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
      "locator": { "type": "object", "additionalProperties": false, "required": ["path", "line"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 1024 }, "line": { "type": "integer", "minimum": 1, "maximum": 10000000 } } }, "claim": { "type": "string", "minLength": 1, "maxLength": 8000 }, "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }, "resolution_condition": { "type": "string", "minLength": 1, "maxLength": 4000 }, "dependency_keys": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }, "duplicate_of": { "type": ["string", "null"] }, "history": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "object", "additionalProperties": false, "required": ["event", "at"], "properties": { "event": { "enum": ["opened", "reaffirmed", "resolved", "reopened", "superseded"] }, "at": { "type": "string", "minLength": 20, "maxLength": 40 } } } }
    }
  },
  "criterion_evaluation": {
    "type": "object", "additionalProperties": false, "required": ["criterion_id", "score", "anchor_status", "blocking_issue_ids", "advisory_issue_ids", "dependency_declaration", "basis", "change_reason_ids", "context_digest"],
    "properties": { "criterion_id": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" }, "score": { "type": "integer", "minimum": 1, "maximum": 10 }, "anchor_status": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["id", "status", "evidence_refs"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 200 }, "status": { "enum": ["met", "unmet", "unknown", "not_applicable"] }, "evidence_refs": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 200 } } } } }, "blocking_issue_ids": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^ISS-[A-Za-z0-9._-]{1,120}$" } }, "advisory_issue_ids": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^ISS-[A-Za-z0-9._-]{1,120}$" } }, "dependency_declaration": { "type": "object", "additionalProperties": false, "required": ["artifact_paths", "upstream_contract_ids", "scope_ids", "rubric_clause_ids", "evidence_kinds", "verification_env_keys"], "properties": { "artifact_paths": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 1024 } }, "upstream_contract_ids": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 200 } }, "scope_ids": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 200 } }, "rubric_clause_ids": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 200 } }, "evidence_kinds": { "type": "array", "maxItems": 10, "items": { "enum": ["locator", "command", "upstream", "unknown", "not_applicable"] } }, "verification_env_keys": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 200 } } } }, "basis": { "enum": ["fresh", "reused", "re_evaluated", "corrected", "unknown", "not_applicable"] }, "change_reason_ids": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^CR-[A-Za-z0-9._-]{1,120}$" } }, "context_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
  },
  "change_reason": {
    "type": "object", "additionalProperties": false, "required": ["id", "reason", "before_digest", "after_digest", "diff_locator", "affected_dependency_keys", "requested_by", "at", "condition_status"],
    "properties": { "id": { "type": "string", "pattern": "^CR-[A-Za-z0-9._-]{1,120}$" }, "reason": { "enum": ["artifact_change", "evidence_change", "upstream_finalized_change", "scope_change", "rubric_change", "environment_change", "evaluation_correction"] }, "before_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "after_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "diff_locator": { "type": "string", "minLength": 1, "maxLength": 2000 }, "affected_dependency_keys": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "maxLength": 500 } }, "requested_by": { "type": "string", "minLength": 1, "maxLength": 200 }, "at": { "type": "string", "minLength": 20, "maxLength": 40 }, "condition_status": { "enum": ["changed", "unchanged", "unknown", "not_applicable"] }, "approval_record_id": { "type": "string", "minLength": 1, "maxLength": 200 }, "evidence_refs": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 200 } }, "upstream_contract_ids": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 200 } }, "correction_basis": { "type": "string", "minLength": 1, "maxLength": 4000 } }
  }
}
