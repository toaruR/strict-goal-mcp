{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strict-goal-round-reduction-schema.json",
  "title": "Strict-goal round-reduction design support package",
  "type": "object",
  "additionalProperties": false,
  "required": ["package", "version", "schema_version", "files", "entrypoints", "portability"],
  "properties": {
    "package": {"const": "strict-goal-round-reduction-design-support"},
    "version": {"type": "string", "pattern": "^2\\.[0-9]+\\.[0-9]+-draft\\.[0-9]+$"},
    "schema_version": {"const": "round-reduction-v2"},
    "files": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}},
    "entrypoints": {"type": "array", "minItems": 1, "items": {"enum": ["score_submit", "loop_state"]}},
    "portability": {"type": "object", "additionalProperties": false, "required": ["allowed_environment_variables", "fallback"], "properties": {"allowed_environment_variables": {"type": "array", "maxItems": 0}, "fallback": {"const": "resolve paths relative to this manifest; use the Node executable on PATH"}}}
  }
}
